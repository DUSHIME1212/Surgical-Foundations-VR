    spatialBlend: 0
    minDistance: 0.5
    maxDistance: 12
    subtitle: Stand or sit naturally, and look ahead.
  - id: 602
    category: 4
    clips:
    - {fileID: 8300000, guid: b207b2d6d996e414a84638fc950d6ca6, type: 3}
    volume: 1
    pitchVariance: 0
    loop: 0
    spatialBlend: 0
    minDistance: 0.5
    maxDistance: 12
    subtitle: "Grab the table edge and move it until your elbows sit at about 90\xB0."
  - id: 603
    category: 4
    clips:
    - {fileID: 8300000, guid: c198949318284fc47b2fe5df5bcdd5e7, type: 3}
    volume: 1
    pitchVariance: 0
    loop: 0
    spatialBlend: 0
    minDistance: 0.5
    maxDistance: 12
    subtitle: Squeeze the trigger to close the grasper around the peg.
  - id: 604
    category: 4
    clips:
    - {fileID: 8300000, guid: 6d04dace36c69734a9efa0b0181169f1, type: 3}
    volume: 1
    pitchVariance: 0
    loop: 0
    spatialBlend: 0
    minDistance: 0.5
    maxDistance: 12
    subtitle: Keep your hands above your elbows so water runs away from your fingertips.
  - id: 605
    category: 4
    clips:
